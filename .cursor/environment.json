{
  "name": "Agentic-SpliceAI",
  "user": "ubuntu",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "splice-api",
      "command": ". .venv/bin/activate && python -m uvicorn server.splice_service:app --host 0.0.0.0 --port 8004",
      "description": "Splice-analysis REST API (FastAPI). Swagger UI at http://localhost:8004/docs"
    }
  ],
  "ports": [
    {
      "port": 8004,
      "name": "splice-api"
    }
  ]
}
